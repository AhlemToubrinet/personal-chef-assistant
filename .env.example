# ---------------------------------------------------------------------------
# Example environment file for the Personal Chef Assistant notebook.
#
# 1. Copy this file to ".env" in the same folder as the notebook:
#        cp .env.example .env          (macOS / Linux)
#        copy .env.example .env        (Windows)
# 2. Replace the placeholder values with your own API keys.
# 3. Never commit the real ".env" file - it is already ignored by .gitignore.
# ---------------------------------------------------------------------------

# Google AI Studio key - used to call the Gemini chat / vision / audio model.
# Get one here: https://aistudio.google.com/apikey
GOOGLE_API_KEY="your_google_api_key_here"

# Tavily key - used by the search_recipes tool to search the web for recipes.
# Get one here: https://app.tavily.com
TAVILY_API_KEY="your_tavily_api_key_here"
